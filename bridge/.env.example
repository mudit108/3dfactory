# Copy this file to ".env" in the same folder and fill in the password.
EMS_URL=http://localhost:8080
EMS_USER=admin
EMS_PASSWORD=
PORT=8787
# 0.0.0.0 = phones/PCs on the same Wi-Fi can open it; 127.0.0.1 = this PC only
BIND=0.0.0.0
POLL_MS=4000
# EMS only reports meters left on the warp beam. Meters on a FULL beam (used for the % bar in 3D):
BEAM_FULL_M=6000
# Meters/day one loom makes at 100% efficiency (used for the production progress bar):
TARGET_M=150

# --- Optional: show live data on your Vercel site ---
# Address of your Vercel project's push function, and the secret token (same value as PUSH_TOKEN on Vercel)
PUSH_URL=
PUSH_TOKEN=
